<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".UploadActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/backbtn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JORRA AI"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:gravity="center"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#BDBDBD"
            android:layout_marginTop="8dp"/>

        <!-- Subject Photo Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subject Photo"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:fontFamily="sans-serif-black"
            android:paddingStart="10dp"
            android:paddingTop="16dp"/>

        <!-- Image Preview Frame -->
        <FrameLayout
            android:id="@+id/imagePreviewFrame"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_margin="15dp"
            android:background="#F8F9FE"
            android:clipToPadding="false"
            android:padding="10dp">

            <!-- Dotted border background -->
            <View
                android:id="@+id/dottedBorder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/dotted_border" />

            <!-- Image Preview -->
            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:visibility="gone"/>

            <!-- Upload Center -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/uploadIcon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Upload Icon"
                    android:src="@drawable/upload" />

                <TextView
                    android:id="@+id/supportedFormatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Supported Format: PNG, JPEG, JPG"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"/>

                <Button
                    android:id="@+id/selectFileBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/black"
                    android:textColor="@android:color/white"
                    android:text="Select File"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"/>
            </LinearLayout>

        </FrameLayout>

        <!-- Hair Style Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hair Style"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:paddingStart="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose a hairstyle that suits your face"
            android:textSize="15sp"
            android:textColor="#757575"
            android:fontFamily="sans-serif"
            android:paddingStart="10dp"
            android:paddingBottom="8dp"/>

        <!-- Hairstyle RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewHairstyles"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipToPadding="false"/>

        <!-- Try-ons text -->
        <!-- <TextView
             android:id="@+id/tryOnsText"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="Try-ons left: 0"
             android:paddingStart="10dp"
             android:paddingTop="12dp"
             android:textColor="@color/black"
             android:textSize="16sp"
             android:fontFamily="sans-serif-medium"/> -->

         <!-- Submit Button -->
        <Button
            android:id="@+id/submitformbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/black"/>

        <!-- Logout Button -->
        <Button
            android:id="@+id/logoutBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log out"
            android:textColor="@android:color/white"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/black"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
